# Copy to .env and edit locally. Never commit .env. dotnet run does NOT load .env automatically.
POSTGRES_PASSWORD=replace-with-a-generated-local-password
ConnectionStrings__Database=Host=127.0.0.1;Database=telegram_pm;Username=telegram_pm;Password=replace-with-the-same-local-password
Database__AutoMigrate=true
# Leave integrations disabled until credentials and participant consent are configured.
Telegram__Enabled=false
Telegram__Token=
Telegram__Groups__0__ChatId=-1001234567890
Telegram__Groups__0__Name=TradeFlow AI
Telegram__Groups__0__ManagerUserIds__0=123456789
Telegram__Groups__0__TimeZone=Europe/Warsaw
Ai__Enabled=false
Ai__Provider=OpenAICompatible
# Exact HTTPS chat completions URL, for a provider available in your jurisdiction.
Ai__Endpoint=
Ai__Model=
Ai__ApiKey=
Ai__MaxMessages=30
Ai__MaxCharacters=12000
Ai__AutoAnalyzeMinutes=15
Ai__MinNewMessages=5
Ai__MinConfidence=0.7
Management__Enabled=true
Management__MessageRetentionDays=14
Management__AnalysisRetentionDays=14
Management__HistoryRetentionDays=90
Management__QuietStartHour=20
Management__QuietEndHour=8
Management__DailySummaryHour=17
Management__WeeklyReportHour=16
Management__WeeklyReportDay=Friday
Management__MaxProactivePerDay=4
